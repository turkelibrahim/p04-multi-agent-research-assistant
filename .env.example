# Çok Ajanlı Araştırma Asistanı — Ortam Ayarları Örneği
# Bu dosyayı ".env" adıyla kopyalayıp kendi API anahtarlarınızı girin.

OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Çalışma sınırları
MAX_MODEL_CALLS=10
MAX_SEARCH_CALLS_FAST=1
MAX_SEARCH_CALLS_STANDARD=4
MAX_INITIAL_QUERIES_STANDARD=3
MAX_RESULTS_PER_QUERY=5
MAX_SOURCE_CHARS=3500
MODEL_TIMEOUT_SEC=60
SEARCH_TIMEOUT_SEC=20
TOTAL_RUN_TIMEOUT_SEC=300

# Veritabanı yolu
P04_DB_PATH=data/research_assistant.db
